#!/bin/sh
# CMDSCRIPT de upssched (execute en utilisateur nut). Recu : nom du timer/evenement.
TAG=hmd-ups
case "$1" in
  onbatt)
    logger -t "$TAG" -p daemon.warning "Secteur coupe : serveur sur batterie" ;;
  online)
    logger -t "$TAG" -p daemon.notice  "Secteur retabli : extinction annulee" ;;
  lowbatt)
    logger -t "$TAG" -p daemon.crit    "Batterie faible : extinction en cours" ;;
  commbad)
    logger -t "$TAG" -p daemon.err     "Communication avec l'onduleur perdue" ;;
  commok)
    logger -t "$TAG" -p daemon.notice  "Communication avec l'onduleur retablie" ;;
  replbatt)
    logger -t "$TAG" -p daemon.err     "Batterie de l'onduleur a remplacer" ;;
  onbatt_timeout)
    if [ -f /etc/hmd-server/ups-dry-run ]; then
      logger -t "$TAG" -p daemon.warning "DRY-RUN : delai sur batterie depasse, FSD non declenche"
      exit 0
    fi
    logger -t "$TAG" -p daemon.crit "Delai sur batterie depasse : declenchement FSD"
    # upsmon tourne en root : passage par sudo (regle /etc/sudoers.d/hmd-nut)
    sudo -n /sbin/upsmon -c fsd || logger -t "$TAG" -p daemon.err "Echec upsmon -c fsd" ;;
  *)
    logger -t "$TAG" "Evenement inconnu : $1" ;;
esac
