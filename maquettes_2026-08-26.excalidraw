   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Le blocage se voit : ERPNext refuse\nd'enregistrer et dit quelle ligne manque,\net de combien.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Le blocage se voit : ERPNext refuse\nd'enregistrer et dit quelle ligne manque,\net de combien.",
   "lineHeight": 1.25,
   "autoResize": true
  },
