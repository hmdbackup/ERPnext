   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Indicateur                                       │ Valeur     │ Unité\n─────────────────────────────────────────────────┼────────────┼──────\n── FRAIS GÉNÉRAUX — RÉPARTITION PAR ATELIER ──   │            │      \nAssurances                                       │   1 900.00 │ DT   \n    └ Lait 45 % · Cultures 35 % · Génisses 20 %  │            │      \nTotal Frais Généraux du mois                     │   9 840.00 │ DT   \ndont part atelier Lait — somme des répartitions  │   5 525.00 │ DT   ",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Indicateur                                       │ Valeur     │ Unité\n─────────────────────────────────────────────────┼────────────┼──────\n── FRAIS GÉNÉRAUX — RÉPARTITION PAR ATELIER ──   │            │      \nAssurances                                       │   1 900.00 │ DT   \n    └ Lait 45 % · Cultures 35 % · Génisses 20 %  │            │      \nTotal Frais Généraux du mois                     │   9 840.00 │ DT   \ndont part atelier Lait — somme des répartitions  │   5 525.00 │ DT   ",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
