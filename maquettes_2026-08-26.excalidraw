   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el254",
   "x": 0,
   "y": 4897.75,
   "width": 1046.76,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#5c5f66",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
