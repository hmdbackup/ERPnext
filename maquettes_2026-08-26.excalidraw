   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Le comptable ne change pas d'écran : c'est\nla facture d'achat de l'écran 1, avec un\nchamp de plus.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
