   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el174",
   "x": 530,
   "y": 2808,
   "width": 435.59999999999997,
   "height": 55.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
