  {
   "id": "el563",
   "x": 1030,
   "y": 8177.75,
   "width": 411.84000000000003,
   "height": 146.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
