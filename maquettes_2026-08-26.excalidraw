   "locked": false,
   "type": "text",
   "text": "Cette facture, atelier par atelier │ DT        \n───────────────────────────────────┼───────────\nLait — 45 %                        │     855.00\nCultures — 35 %                    │     665.00\nGénisses — 20 %                    │     380.00\n────────────────────────────────── │ ──────────\n= la facture                       │   1 900.00",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Cette facture, atelier par atelier │ DT        \n───────────────────────────────────┼───────────\nLait — 45 %                        │     855.00\nCultures — 35 %                    │     665.00\nGénisses — 20 %                    │     380.00\n────────────────────────────────── │ ──────────\n= la facture                       │   1 900.00",
   "lineHeight": 1.25,
   "autoResize": true
  },
