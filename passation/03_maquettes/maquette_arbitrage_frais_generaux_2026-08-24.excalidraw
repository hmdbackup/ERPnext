   "roundness": null,
   "seed": 1043,
   "version": 1,
   "versionNonce": 2043,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "• Frais généraux : arbitrage CAS PAR CAS. Chaque dépense\n  porte sa clé — A (ce que l'atelier dépense) ou B (ce\n  qu'il rapporte). Plus de clé unique pour tout le mois.\n\n• La clé appliquée est conservée ligne par ligne, pour que\n  le coût d'un mois passé reste explicable.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "• Frais généraux : arbitrage CAS PAR CAS. Chaque dépense\n  porte sa clé — A (ce que l'atelier dépense) ou B (ce\n  qu'il rapporte). Plus de clé unique pour tout le mois.\n\n• La clé appliquée est conservée ligne par ligne, pour que\n  le coût d'un mois passé reste explicable.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el44",
   "x": 760,
   "y": 712,
   "width": 760,
   "height": 206.25,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "#fff3bf",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
