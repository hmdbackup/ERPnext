  },
  {
   "id": "el43",
   "x": 14,
   "y": 752,
   "width": 497.64000000000004,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
