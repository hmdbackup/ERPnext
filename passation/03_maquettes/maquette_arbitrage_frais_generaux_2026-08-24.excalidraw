   "type": "text",
   "text": "À décider avant de construire",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "À décider avant de construire",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el46",
   "x": 774,
   "y": 752,
   "width": 497.64000000000004,
   "height": 146.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
