   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Indicateur                                 │ Valeur │ Unité   │ Pourquoi                      \n───────────────────────────────────────────┼────────┼─────────┼───────────────────────────────\nVaches en lactation (VL) — moyenne du mois │      0 │      VL │ aucun vêlage enregistré       \nLitres / vache lactante / jour             │      — │  L/VL/j │ sans VL, pas de dénominateur  \nLitres / vache présente / jour             │   12.8 │  L/VP/j │ VP vient de l'effectif présent",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Indicateur                                 │ Valeur │ Unité   │ Pourquoi                      \n───────────────────────────────────────────┼────────┼─────────┼───────────────────────────────\nVaches en lactation (VL) — moyenne du mois │      0 │      VL │ aucun vêlage enregistré       \nLitres / vache lactante / jour             │      — │  L/VL/j │ sans VL, pas de dénominateur  \nLitres / vache présente / jour             │   12.8 │  L/VP/j │ VP vient de l'effectif présent",
   "lineHeight": 1.25,
   "autoResize": true
  },
