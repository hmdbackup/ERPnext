   "boundElements": [],
   "updated": 1787392834867,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Disponible ?  ( ) oui   (•) non\n\nÉtat ▾\n  ┌───────────────────────┐\n  │ Bon                   │\n  │ À vérifier            │\n  │ Hors service          │\n  └───────────────────────┘",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Disponible ?  ( ) oui   (•) non\n\nÉtat ▾\n  ┌───────────────────────┐\n  │ Bon                   │\n  │ À vérifier            │\n  │ Hors service          │\n  └───────────────────────┘",
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b2m"
  },
  {
   "id": "-EM07d2BohOQk-3Eq1xrj",
   "x": -957.9187800286963,
