   "autoResize": true,
   "index": "b2q"
  },
  {
   "id": "HTaX-Z6TaTcWT-alnGv38",
   "x": -1473.9187800286963,
   "y": 626.8288640473277,
   "width": 954.8,
   "height": 35,
   "angle": 0,
   "strokeColor": "#5c5f66",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
