   "isDeleted": false,
   "boundElements": [],
   "updated": 1787392834867,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Le tracteur Massey tousse au démarrage,\nmais il roule encore et il part demain.\n\nTu le mets où ?",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Le tracteur Massey tousse au démarrage,\nmais il roule encore et il part demain.\n\nTu le mets où ?",
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b2o"
  },
