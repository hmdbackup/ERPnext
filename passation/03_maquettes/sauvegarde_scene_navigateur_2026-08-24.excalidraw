   "isDeleted": false,
   "boundElements": [],
   "updated": 1787392834867,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Aujourd'hui : aucune des deux — le système ne connaît que le statut comptable d'ERPNext (en service, cédé, mis\nau rebut). L'état mécanique n'existe nulle part.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Aujourd'hui : aucune des deux — le système ne connaît que le statut comptable d'ERPNext (en service, cédé, mis\nau rebut). L'état mécanique n'existe nulle part.",
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b2r"
  },
