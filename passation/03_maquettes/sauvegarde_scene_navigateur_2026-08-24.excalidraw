   "boundElements": [],
   "updated": 1787392834867,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Deux clics au lieu d'un. En échange,\non sait dire « elle marche encore mais\nil faut la regarder ».",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Deux clics au lieu d'un. En échange,\non sait dire « elle marche encore mais\nil faut la regarder ».",
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b2n"
  },
  {
   "id": "iTmRV4I31KCtVzuKNTbRV",
   "x": -473.91878002869635,
   "y": 362.07886404732767,
   "width": 411.06,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
