   "link": null,
   "locked": false,
   "type": "text",
   "text": "État ▾\n  ┌───────────────────────┐\n  │ Prêt à fonctionner    │\n  │ En panne              │\n  │ En attente de mainten.│\n  └───────────────────────┘",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "État ▾\n  ┌───────────────────────┐\n  │ Prêt à fonctionner    │\n  │ En panne              │\n  │ En attente de mainten.│\n  └───────────────────────┘",
