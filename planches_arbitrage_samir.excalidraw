   "type": "text",
   "text": "Ce point-là n'est pas un choix — c'est une donnée qui manque",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Ce point-là n'est pas un choix — c'est une donnée qui manque",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el149",
   "x": 16,
   "y": 3506.25,
   "width": 1137.08,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
