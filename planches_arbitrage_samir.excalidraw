   "type": "text",
   "text": "Tout est compté. Mais on impute au lait\ndes charges dont on ignore encore\nà quel atelier elles appartiennent.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Tout est compté. Mais on impute au lait\ndes charges dont on ignore encore\nà quel atelier elles appartiennent.",
   "lineHeight": 1.25,
   "autoResize": true
  },
