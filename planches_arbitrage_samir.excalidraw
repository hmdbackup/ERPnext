   "link": null,
   "locked": false,
   "type": "text",
   "text": "Disponible ?  ( ) oui   (•) non\n\nÉtat ▾\n  ┌───────────────────────┐\n  │ Bon                   │\n  │ À vérifier            │\n  │ Hors service          │\n  └───────────────────────┘",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Disponible ?  ( ) oui   (•) non\n\nÉtat ▾\n  ┌───────────────────────┐\n  │ Bon                   │\n  │ À vérifier            │\n  │ Hors service          │\n  └───────────────────────┘",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
