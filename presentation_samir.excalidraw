  {
   "id": "pr86",
   "x": 24.0,
   "y": 3832.75,
   "width": 748.8,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1145,
   "version": 1,
   "versionNonce": 2145,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Jour     │ Somme des traites │ Bilan ferme │ Lait vendu │ Lait veau │ Conso int. │ Écart déclaré\n─────────┼───────────────────┼─────────────┼────────────┼───────────┼────────────┼──────────────\n01/06    │             1 643 │       1 471 │      1 436 │        35 │          0 │             0\n06/06    │             1 500 │       1 336 │      1 501 │        35 │          0 │          -200\n09/06    │             1 569 │       1 328 │      1 267 │        35 │         26 │             0\n12/06    │             1 562 │       1 380 │      1 550 │        30 │          0 │          -200\n20/06    │             1 418 │       1 261 │      1 226 │        35 │          0 │             0\n26/06    │             1 533 │       1 393 │      1 338 │        35 │         20 │             0\n27/06    │             1 494 │           — │          — │         — │          — │             —\n28/06    │             1 448 │           — │          — │         — │          — │             —\nTOTAL    │            45 444 │      35 485 │     36 519 │       920 │         46 │        -2 000",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Jour     │ Somme des traites │ Bilan ferme │ Lait vendu │ Lait veau │ Conso int. │ Écart déclaré\n─────────┼───────────────────┼─────────────┼────────────┼───────────┼────────────┼──────────────\n01/06    │             1 643 │       1 471 │      1 436 │        35 │          0 │             0\n06/06    │             1 500 │       1 336 │      1 501 │        35 │          0 │          -200\n09/06    │             1 569 │       1 328 │      1 267 │        35 │         26 │             0\n12/06    │             1 562 │       1 380 │      1 550 │        30 │          0 │          -200\n20/06    │             1 418 │       1 261 │      1 226 │        35 │          0 │             0\n26/06    │             1 533 │       1 393 │      1 338 │        35 │         20 │             0\n27/06    │             1 494 │           — │          — │         — │          — │             —\n28/06    │             1 448 │           — │          — │         — │          — │             —\nTOTAL    │            45 444 │      35 485 │     36 519 │       920 │         46 │        -2 000",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "pr87",
   "x": 24.0,
   "y": 4031.5,
   "width": 1015.56,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#5c5f66",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
