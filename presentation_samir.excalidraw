  {
   "id": "pr42",
   "x": 154.0,
   "y": 1817.25,
   "width": 733.1999999999999,
   "height": 503.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
