   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "text": "Bilan saisi 26 jours sur 30  ·  les 27, 28, 29 et 30 juin, les vaches ont été traites mais aucun bilan n'a été rempli",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Bilan saisi 26 jours sur 30  ·  les 27, 28, 29 et 30 juin, les vaches ont été traites mais aucun bilan n'a été rempli",
   "lineHeight": 1.25,
   "autoResize": true
  },
